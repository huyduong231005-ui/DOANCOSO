# Sao chép file này thành .env (cùng thư mục) rồi điền giá trị. File .env không được commit.
# Tên biến dùng hai dấu gạch dưới thay cho dấu hai chấm trong cấu hình (Smtp:Host -> Smtp__Host).

# Gửi email thật qua Gmail. Để trống Smtp__Password thì app chỉ ghi email vào log.
Smtp__Host=smtp.gmail.com
Smtp__User=
# Mật khẩu ứng dụng 16 ký tự, tạo tại https://myaccount.google.com/apppasswords
Smtp__Password=
# Demo: dồn mọi email về một hộp thư, người nhận gốc được ghi vào tiêu đề. Để trống thì gửi đúng người nhận.
Smtp__RedirectAllTo=

# Chuỗi kết nối PostgreSQL. Bỏ trống nếu đã đặt trong biến môi trường của máy.
ConnectionStrings__DefaultConnection=
