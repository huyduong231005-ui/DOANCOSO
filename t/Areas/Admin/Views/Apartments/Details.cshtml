@model t.Areas.Admin.Models.ApartmentDetailVm
@{
    var a = Model.Apartment;
    ViewData["Title"] = "Căn " + a.UnitCode;
    string Money(decimal v) => v.ToString("N0");
    var living = a.Residents.Where(r => r.IsActive).ToList();
    var moved = a.Residents.Where(r => !r.IsActive).ToList();
    var rented = living.Any(r => r.Role == ResidentRole.Tenant);
    var returnUrl = Url.Action("Details", new { id = a.Id });
    string Pill(ApartmentOccupancy o) => o switch
    {
        ApartmentOccupancy.Occupied => "pill pill-success",
        ApartmentOccupancy.Vacant => "pill pill-neutral",
        ApartmentOccupancy.NotHandedOver => "pill pill-info",
        ApartmentOccupancy.UnderMaintenance => "pill pill-warning",
        _ => "pill"
    };
    string InvPill(InvoiceStatus s) => s switch
    {
        InvoiceStatus.Paid => "pill pill-success",
        InvoiceStatus.Overdue => "pill pill-danger",
        InvoiceStatus.PartiallyPaid => "pill pill-warning",
        InvoiceStatus.Cancelled => "pill pill-neutral",
        _ => "pill pill-info"
    };
    string Initial(string name) => name.Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?[..1] ?? "?";
}

<section class="page-header">
    <div>
        <span class="eyebrow"><span class="material-symbols-outlined" style="font-size:16px;">door_front</span>@a.Floor.Building.Name · Tầng @a.Floor.Number</span>
        <h1>Căn @a.UnitCode</h1>
        <p class="subtitle">@a.Area.ToString("0.#") m² · @a.Bedrooms phòng ngủ</p>
        <div class="hstack" style="margin-top:.45rem;flex-wrap:wrap;">
            <span class="@Pill(a.Occupancy)">@a.Occupancy.Vi()</span>
            @if (rented) { <span class="pill pill-info">Cho thuê</span> }
            @if (Model.OverdueBalance > 0) { <span class="pill pill-danger">Nợ quá hạn @Money(Model.OverdueBalance) đ</span> }
        </div>
    </div>
    <div class="actions">
        <form asp-action="ChangeStatus" asp-route-id="@a.Id" method="post" class="quick-status-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <select name="status" onchange="this.form.submit()" aria-label="Đổi tình trạng căn">
                @foreach (var o in Enum.GetValues<ApartmentCondition>())
                {
                    <option value="@o" selected="@(o == a.Condition)">@o.Vi()</option>
                }
            </select>
        </form>
        <form asp-action="GenerateInvoice" asp-route-id="@a.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-accent"><span class="material-symbols-outlined">receipt_long</span>Lập hoá đơn tháng</button>
        </form>
        <a class="btn btn-outline" asp-action="Edit" asp-route-id="@a.Id"><span class="material-symbols-outlined">edit</span>Sửa</a>
    </div>
</section>

<div class="detail-grid">
    <div class="vstack" style="gap:1.2rem;">
        <details class="card fold" data-fold="residents" open>
            <summary class="card-header">
                <h2>Cư dân <span class="text-muted" style="font-weight:500;">(@living.Count)</span></h2>
                <span class="text-muted" style="font-size:13px;">Người đại diện nhận thông báo phí và email nhắc nợ</span>
            </summary>
            <div class="card-body vstack" style="gap:.8rem;">
                @if (!living.Any())
                {
                    <p class="text-muted" style="margin:0;">Căn chưa có cư dân. Thêm người vào ở bên dưới.</p>
                }
                <div class="people">
                    @foreach (var r in living)
                    {
                        <div class="person">
                            <span class="avatar">@Initial(r.User.FullName)</span>
                            <div class="who">
                                <b>@r.User.FullName</b>
                                <small>
                                    @(r.User.PhoneNumber ?? "—") · @(r.User.Email ?? "chưa có email")
                                    · vào ở @r.MoveInDate.ToString("dd/MM/yyyy")
                                    @if (r.UserId != null) { <text> · <span title="Đăng nhập được cổng cư dân">có tài khoản</span></text> }
                                </small>
                            </div>
                            @if (r.IsPrimary) { <span class="tag primary">Đại diện</span> }
                            <span class="tag">@r.Role.Vi()</span>
                            @if (r.UserId == null && r.User.Email != null)
                            {
                                <form asp-action="ResendInvite" method="post" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="residentId" value="@r.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Chưa có tài khoản: gửi (lại) thư mời tạo tài khoản tới @r.User.Email"><span class="material-symbols-outlined">forward_to_inbox</span></button>
                                </form>
                            }
                            @if (!r.IsPrimary)
                            {
                                <form asp-action="SetPrimary" method="post" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="residentId" value="@r.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Đặt làm đại diện"><span class="material-symbols-outlined">star</span></button>
                                </form>
                            }
                            <form asp-action="MoveOut" method="post" style="margin:0;" data-confirm="Ghi nhận @r.User.FullName đã chuyển đi khỏi căn @a.UnitCode?" data-confirm-title="Chuyển đi" data-confirm-ok="Xác nhận">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="residentId" value="@r.Id" />
                                <button type="submit" class="btn btn-ghost btn-sm" title="Chuyển đi"><span class="material-symbols-outlined">logout</span></button>
                            </form>
                        </div>
                    }
                </div>

                <details class="reveal">
                    <summary class="btn btn-outline btn-sm"><span class="material-symbols-outlined">person_add</span>Thêm cư dân</summary>
                    <form asp-action="AddResident" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ApartmentId" value="@a.Id" />
                        <label>Họ tên<input name="FullName" required maxlength="150" /></label>
                        <label>Vai trò
                            <select name="Role">
                                @foreach (var role in Enum.GetValues<ResidentRole>())
                                {
                                    <option value="@role" selected="@(role == Model.NewResident.Role)">@role.Vi()</option>
                                }
                            </select>
                        </label>
                        <label>Số điện thoại<input name="Phone" maxlength="30" /></label>
                        <label>Email<input name="Email" type="email" maxlength="200" placeholder="Có tài khoản → tự liên kết, chưa có → gửi thư mời" /></label>
                        <label>CCCD / hộ chiếu<input name="IdNumber" maxlength="30" /></label>
                        <label>Ngày vào ở<input name="MoveInDate" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></label>
                        <label class="full">Ghi chú<input name="Note" maxlength="1000" /></label>
                        <label class="check full"><input type="checkbox" name="IsPrimary" value="true" /> Đặt làm người đại diện căn</label>
                        <div class="full"><button type="submit" class="btn btn-primary btn-sm">Lưu cư dân</button></div>
                    </form>
                </details>

                @if (moved.Any())
                {
                    <details class="reveal">
                        <summary class="text-muted" style="font-size:13px;">Đã chuyển đi (@moved.Count)</summary>
                        <div class="people">
                            @foreach (var r in moved)
                            {
                                <div class="person moved">
                                    <span class="avatar">@Initial(r.User.FullName)</span>
                                    <div class="who"><b>@r.User.FullName</b><small>@r.Role.Vi() · @r.MoveInDate.ToString("dd/MM/yyyy") → @r.MoveOutDate?.ToString("dd/MM/yyyy")</small></div>
                                </div>
                            }
                        </div>
                    </details>
                }
            </div>
        </details>

        <details class="card fold" data-fold="invoices" open>
            <summary class="card-header">
                <h2>Hoá đơn
                    @if (Model.Balance > 0) { <span style="color:var(--st-debt);font-size:14px;font-weight:600;">· còn nợ @Money(Model.Balance) đ</span> }
                </h2>
                <div class="hstack">
                    <a class="btn btn-ghost btn-sm" asp-controller="Invoices" asp-action="Index" asp-route-q="@a.UnitCode">Tất cả</a>
                    <a class="btn btn-outline btn-sm" asp-controller="Invoices" asp-action="CreateOneOff" asp-route-apartmentId="@a.Id"><span class="material-symbols-outlined">add</span>Phát sinh</a>
                </div>
            </summary>
            <div class="table-wrap">
                <table class="data-table nowrap">
                    <thead><tr><th>Số HĐ</th><th>Loại</th><th>Kỳ</th><th>Hạn</th><th class="num">Tổng</th><th class="num">Còn lại</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                    @if (!Model.Invoices.Any())
                    {
                        <tr><td colspan="7"><div class="empty-state"><span class="material-symbols-outlined">receipt_long</span><h3>Chưa có hoá đơn</h3></div></td></tr>
                    }
                    @foreach (var i in Model.Invoices)
                    {
                        <tr data-href="@Url.Action("Details", "Invoices", new { id = i.Id })">
                            <td><span class="row-title">@i.InvoiceNumber</span></td>
                            <td>@i.Kind.Vi()</td>
                            <td>@(i.BillingMonth % 100)/@(i.BillingMonth / 100)</td>
                            <td>@i.DueDate.ToString("dd/MM/yyyy")</td>
                            <td class="num">@Money(i.Total)</td>
                            <td class="num">@Money(i.Balance)</td>
                            <td><span class="@InvPill(i.Status)">@i.Status.Vi()</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>

        <details class="card fold" data-fold="readings">
            <summary class="card-header">
                <h2>Chỉ số điện / nước <span class="text-muted" style="font-weight:500;">(@Model.Readings.Count)</span></h2>
                <a class="btn btn-outline btn-sm" asp-controller="Utilities" asp-action="CreateReading" asp-route-apartmentId="@a.Id"><span class="material-symbols-outlined">add</span>Nhập chỉ số</a>
            </summary>
            <div class="table-wrap">
                <table class="data-table nowrap">
                    <thead><tr><th>Kỳ</th><th>Loại</th><th class="num">Cũ</th><th class="num">Mới</th><th class="num">Tiêu thụ</th><th class="num">Thành tiền</th><th></th></tr></thead>
                    <tbody>
                    @if (!Model.Readings.Any())
                    {
                        <tr><td colspan="7" class="text-muted" style="text-align:center;padding:1rem;">Chưa có chỉ số.</td></tr>
                    }
                    @foreach (var r in Model.Readings)
                    {
                        <tr>
                            <td>@(r.BillingMonth % 100)/@(r.BillingMonth / 100)</td>
                            <td>@r.UtilityType.Name</td>
                            <td class="num">@r.PreviousReading.ToString("0.##")</td>
                            <td class="num">@r.CurrentReading.ToString("0.##")</td>
                            <td class="num">@r.Consumption.ToString("0.##") @r.UtilityType.Unit</td>
                            <td class="num">@Money(r.EstimatedAmount)</td>
                            <td>@(r.Billed ? "Đã lên HĐ" : "Chưa lên HĐ")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    </div>

    <div class="vstack" style="gap:1.2rem;">
        <details class="card fold" data-fold="charges" open>
            <summary class="card-header"><h2>Phí cố định hằng tháng</h2></summary>
            <div class="card-body vstack" style="gap:.6rem;">
                <div class="mini-list">
                    <div class="row"><span>Phí quản lý (@a.Area.ToString("0.#") m² × @Money(a.Floor.Building.ManagementFeePerM2))</span><b>@Money(Model.ManagementFee)</b></div>
                    @foreach (var c in a.RecurringCharges)
                    {
                        <div class="row" style="@(c.IsActive ? "" : "opacity:.5")">
                            <span>@c.Description @if (!c.IsActive) { <small class="muted">(tạm ngưng)</small> }</span>
                            <span class="hstack" style="gap:.2rem;">
                                <b>@Money(c.Amount)</b>
                                <form asp-action="ToggleCharge" method="post" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="chargeId" value="@c.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="@(c.IsActive ? "Tạm ngưng" : "Áp dụng lại")"><span class="material-symbols-outlined">@(c.IsActive ? "pause" : "play_arrow")</span></button>
                                </form>
                                <form asp-action="DeleteCharge" method="post" style="margin:0;" data-confirm="Xoá khoản @c.Description?" data-confirm-ok="Xoá" data-confirm-tone="danger">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="chargeId" value="@c.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" title="Xoá"><span class="material-symbols-outlined">delete</span></button>
                                </form>
                            </span>
                        </div>
                    }
                </div>
                <div class="mini-list">
                    <div class="row"><span>Tổng/tháng <small class="muted">(chưa gồm điện nước)</small></span><b>@Money(Model.MonthlyFixed)</b></div>
                </div>
                <details class="reveal">
                <summary class="btn btn-outline btn-sm"><span class="material-symbols-outlined">add</span>Thêm khoản phí</summary>
                <form asp-action="AddCharge" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ApartmentId" value="@a.Id" />
                    <label>Khoản phí
                        <input name="Description" list="charge-presets" required maxlength="250" placeholder="Gửi xe máy, gửi ô tô…" />
                    </label>
                    <label>Số tiền/tháng<input name="Amount" type="number" min="0" step="1000" required /></label>
                    <datalist id="charge-presets">
                        <option value="Gửi xe máy"></option>
                        <option value="Gửi ô tô"></option>
                        <option value="Gửi xe đạp"></option>
                        <option value="Internet"></option>
                    </datalist>
                    <div class="full"><button type="submit" class="btn btn-primary btn-sm">Lưu khoản phí</button></div>
                </form>
                </details>
            </div>
        </details>

        <details class="card fold" data-fold="maintenance" open>
            <summary class="card-header">
                <h2>Sự cố <span class="text-muted" style="font-weight:500;">(@Model.Maintenance.Count)</span></h2>
                <a class="btn btn-outline btn-sm" asp-controller="Maintenance" asp-action="Create" asp-route-apartmentId="@a.Id"><span class="material-symbols-outlined">add</span>Ghi sự cố</a>
            </summary>
            <div class="card-body">
                @if (!Model.Maintenance.Any())
                {
                    <p class="text-muted" style="margin:0;">Chưa có sự cố.</p>
                }
                <div class="mini-list">
                    @foreach (var m in Model.Maintenance)
                    {
                        <a asp-controller="Maintenance" asp-action="Details" asp-route-id="@m.Id">
                            <span>@m.Title<br /><span class="muted">@m.RequestNumber · @m.ReportedAt.ToLocalTime().ToString("dd/MM/yyyy") · @(m.AssignedTo?.FullName ?? "chưa phân công")</span></span>
                            <span class="pill">@m.Status.Vi()</span>
                        </a>
                    }
                </div>
            </div>
        </details>


        <form asp-action="Delete" asp-route-id="@a.Id" method="post" data-confirm="Chỉ xoá được căn chưa có cư dân và hoá đơn. Xoá căn @a.UnitCode?" data-confirm-title="Xoá căn" data-confirm-ok="Xoá" data-confirm-tone="danger">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-ghost btn-sm"><span class="material-symbols-outlined">delete</span>Xoá căn</button>
        </form>
    </div>
</div>
