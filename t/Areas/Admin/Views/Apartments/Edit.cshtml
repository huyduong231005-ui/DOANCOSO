@model t.Areas.Admin.Models.ApartmentEditVm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Thêm căn hộ" : "Sửa căn " + Model.UnitCode;
}

<section class="page-header">
    <div>
        <h1>@(isNew ? "Thêm căn hộ" : "Căn " + Model.UnitCode)</h1>
        <p class="subtitle">Mã căn theo quy ước {Mã toà}-{Tầng}.{Số căn}, ví dụ A-12.05.</p>
    </div>
    <div class="actions">
        <a class="btn btn-ghost" href="@(isNew ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Quay lại</a>
    </div>
</section>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex");"></div>

    <div class="card">
        <div class="card-header"><h2>Vị trí</h2></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field span-4">
                    <label asp-for="BuildingId">Toà</label>
                    <select asp-for="BuildingId" data-floor-source="@Url.Action("FloorsOf")">
                        @foreach (var b in Model.Buildings)
                        {
                            <option value="@b.Id">@b.Name@(b.Project != null ? " · " + b.Project.Name : "")</option>
                        }
                    </select>
                    <span class="err" asp-validation-for="BuildingId"></span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="FloorId">Tầng</label>
                    <select asp-for="FloorId" data-floor-target>
                        @foreach (var f in Model.Floors) { <option value="@f.Id">@f.Label</option> }
                    </select>
                    <span class="err" asp-validation-for="FloorId"></span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="UnitCode">Mã căn</label>
                    <input asp-for="UnitCode" placeholder="A-12.05" />
                    <span class="err" asp-validation-for="UnitCode"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2>Thông số căn</h2></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field span-3">
                    <label asp-for="Area">Diện tích thông thuỷ (m²)</label>
                    <input asp-for="Area" type="number" step="0.1" min="1" />
                    <span class="hint">Dùng để tính phí quản lý</span>
                    <span class="err" asp-validation-for="Area"></span>
                </div>
                <div class="form-field span-3">
                    <label asp-for="Bedrooms">Phòng ngủ</label>
                    <input asp-for="Bedrooms" type="number" min="0" max="20" />
                    <span class="err" asp-validation-for="Bedrooms"></span>
                </div>
                <div class="form-field span-3">
                    <label asp-for="Bathrooms">Phòng tắm</label>
                    <input asp-for="Bathrooms" type="number" min="0" max="20" />
                    <span class="err" asp-validation-for="Bathrooms"></span>
                </div>
                <div class="form-field span-3">
                    <label asp-for="HouseDirection">Hướng</label>
                    <select asp-for="HouseDirection">
                        <option value="">—</option>
                        @foreach (var d in Enum.GetValues<HouseDirection>()) { <option value="@d">@d.Vi()</option> }
                    </select>
                    <span class="err" asp-validation-for="HouseDirection"></span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="Condition">Tình trạng</label>
                    <select asp-for="Condition">
                        @foreach (var o in Enum.GetValues<ApartmentCondition>()) { <option value="@o">@o.Vi()</option> }
                    </select>
                    <span class="err" asp-validation-for="Condition"></span>
                    <span class="hint">"Đang ở" / "Để trống" tự suy ra từ danh sách cư dân</span>
                </div>
                <div class="form-field span-8">
                    <label asp-for="Note">Ghi chú</label>
                    <textarea asp-for="Note" rows="2" placeholder="Hiện trạng bàn giao, lưu ý kỹ thuật…"></textarea>
                    <span class="err" asp-validation-for="Note"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="hstack mt-3" style="justify-content:flex-end;">
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Đổi toà thì nạp lại danh sách tầng của toà đó.
        (function () {
            const src = document.querySelector('[data-floor-source]');
            const target = document.querySelector('[data-floor-target]');
            if (!src || !target) return;
            src.addEventListener('change', async function () {
                const res = await fetch(src.dataset.floorSource + '?buildingId=' + encodeURIComponent(src.value));
                if (!res.ok) return;
                const floors = await res.json();
                target.innerHTML = '';
                floors.forEach(f => target.add(new Option(f.label, f.id)));
            });
        })();
    </script>
}
