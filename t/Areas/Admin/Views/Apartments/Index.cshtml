@model List<t.Areas.Admin.Models.ApartmentListVm>
@{
    ViewData["Title"] = "Căn hộ";
    var pager = (t.Areas.Admin.Models.PageInfo)ViewBag.Pager;
    var projects = (List<Project>)ViewBag.Projects;
    var buildings = (List<Building>)ViewBag.Buildings;
    var occupancy = (ApartmentOccupancy?)ViewBag.Occupancy;
    var projectId = (int?)ViewBag.ProjectId;
    var buildingId = (int?)ViewBag.BuildingId;
    var debt = (bool)ViewBag.Debt;
    string Money(decimal v) => v.ToString("N0");
    string Pill(ApartmentOccupancy o) => o switch
    {
        ApartmentOccupancy.Occupied => "pill pill-success",
        ApartmentOccupancy.Vacant => "pill pill-neutral",
        ApartmentOccupancy.NotHandedOver => "pill pill-info",
        ApartmentOccupancy.UnderMaintenance => "pill pill-warning",
        _ => "pill"
    };
}

<section class="page-header">
    <div>
        <h1>Căn hộ</h1>
        <p class="subtitle">@pager.TotalCount căn khớp bộ lọc · bấm một dòng để xem nhanh</p>
    </div>
    <div class="actions">
        <a class="btn btn-primary" asp-action="Create"><span class="material-symbols-outlined">add</span>Thêm căn</a>
    </div>
</section>

<form method="get" class="filter-bar">
    <input type="search" name="q" value="@ViewBag.Q" placeholder="Mã căn, tên hoặc SĐT cư dân…"
           data-suggest-url="@Url.Action("Suggest")" data-suggest-icon="door_front" />
    <select name="projectId">
        <option value="">— Tất cả khu —</option>
        @foreach (var p in projects) { <option value="@p.Id" selected="@(projectId == p.Id)">@p.Name</option> }
    </select>
    <select name="buildingId">
        <option value="">— Tất cả toà —</option>
        @foreach (var b in buildings) { <option value="@b.Id" selected="@(buildingId == b.Id)">@b.Name</option> }
    </select>
    <select name="occupancy">
        <option value="">— Tình trạng —</option>
        @foreach (var o in Enum.GetValues<ApartmentOccupancy>()) { <option value="@((int)o)" selected="@(occupancy == o)">@o.Vi()</option> }
    </select>
    <label class="hstack" style="font-size:14px;"><input type="checkbox" name="debt" value="true" checked="@debt" /> Chỉ căn nợ quá hạn</label>
    <button type="submit" class="btn btn-primary">Lọc</button>
    <a class="btn btn-ghost" asp-action="Index">Xoá lọc</a>
</form>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Căn</th><th>Toà · Khu</th><th class="num">Tầng</th><th class="num">Diện tích</th><th>Đại diện</th><th class="num">Cư dân</th><th>Tình trạng</th><th class="num">Còn phải thu</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8"><div class="empty-state"><span class="material-symbols-outlined">door_front</span><h3>Không có căn nào khớp</h3></div></td></tr>
            }
            @foreach (var a in Model)
            {
                <tr data-drawer-url="@Url.Action("Panel", new { id = a.Id })" data-href="@Url.Action("Details", new { id = a.Id })" style="cursor:pointer;">
                    <td><span class="row-title">@a.UnitCode</span><div class="row-meta">@a.Bedrooms PN</div></td>
                    <td>@a.BuildingName<div class="row-meta">@a.ProjectName</div></td>
                    <td class="num">@a.FloorNumber</td>
                    <td class="num">@a.Area.ToString("0.#") m²</td>
                    <td>@(a.RepresentativeName ?? "—")</td>
                    <td class="num">@a.ResidentCount</td>
                    <td><span class="@Pill(a.Occupancy)">@a.Occupancy.Vi()</span></td>
                    <td class="num" style="@(a.Balance > 0 ? "color:var(--st-debt);font-weight:600;" : "")">@Money(a.Balance)</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination", pager)
</div>
