@model t.Areas.Admin.Models.BuildingEditVm
@using t.Models.Entities
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm toà nhà" : "Toà " + Model.Code;
}

<section class="page-header">
    <div><h1>@(Model.Id == 0 ? "Thêm toà nhà" : "Toà " + Model.Code)</h1></div>
    <div class="actions"><a class="btn btn-ghost" href="@(Model.Id == 0 ? Url.Action("Index", "Projects") : Url.Action("Details", new { id = Model.Id }))">Quay lại</a></div>
</section>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex");"></div>

    <div class="card">
        <div class="card-header"><h2>Thông tin toà nhà</h2></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field span-4">
                    <label asp-for="Code">Mã toà</label>
                    <input asp-for="Code" placeholder="A, B, R1…" />
                    <span class="err" asp-validation-for="Code"></span>
                    <span class="hint">Tên toà là "Toà" + mã; mã cũng là tiền tố mã căn: A-12.05</span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="FloorCount">Số tầng</label>
                    <input asp-for="FloorCount" type="number" min="1" max="120" />
                    <span class="err" asp-validation-for="FloorCount"></span>
                    <span class="hint">Tăng số tầng sẽ tự thêm tầng mới</span>
                </div>

                <div class="form-field span-4">
                    <label asp-for="ProjectId">Thuộc khu</label>
                    <select asp-for="ProjectId">
                        <option value="">— Chọn khu —</option>
                        @foreach (var p in Model.Projects) { <option value="@p.Id">@p.Name</option> }
                    </select>
                    <span class="err" asp-validation-for="ProjectId"></span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="ManagerId">Quản lí phụ trách</label>
                    <select asp-for="ManagerId">
                        <option value="">— Chưa phân công —</option>
                        @foreach (var m in Model.Managers) { <option value="@m.Id">@m.Label</option> }
                    </select>
                    <span class="err" asp-validation-for="ManagerId"></span>
                </div>

                <div class="form-field span-4">
                    <label asp-for="Status">Trạng thái</label>
                    <select asp-for="Status">
                        @foreach (var s in Enum.GetValues<BuildingStatus>()) { <option value="@((int)s)">@s.Vi()</option> }
                    </select>
                    <span class="err" asp-validation-for="Status"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2>Thu phí dịch vụ</h2></div>
        <div class="card-body">
            <p class="text-muted" style="font-size:13px;margin-top:0;">
                Hằng tháng vào ngày chốt kỳ, hệ thống tự phát hành hoá đơn cho các căn đã bàn giao:
                phí quản lý = diện tích × đơn giá, cộng điện nước theo chỉ số và các dịch vụ căn đăng ký (gửi xe…).
                Đơn giá lấy từ bảng giá ở mục Điện / Nước → Loại dịch vụ.
            </p>
            <div class="form-grid">
                <div class="form-field span-4">
                    <label asp-for="DefaultBillingDay">Ngày chốt kỳ</label>
                    <input asp-for="DefaultBillingDay" type="number" min="1" max="28" />
                    <span class="hint">Hạn thanh toán = ngày lập hoá đơn + 7 (lập đúng ngày chốt thì là ngày chốt + 7)</span>
                    <span class="err" asp-validation-for="DefaultBillingDay"></span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="DefaultLateFeeAfterDays">Ân hạn trễ (ngày)</label>
                    <input asp-for="DefaultLateFeeAfterDays" type="number" min="0" max="60" />
                    <span class="hint">Quá hạn bao nhiêu ngày thì tính phí trễ</span>
                    <span class="err" asp-validation-for="DefaultLateFeeAfterDays"></span>
                </div>
                <div class="form-field span-4">
                    <label asp-for="DefaultLateFeePercent">Phí trễ (%)</label>
                    <input asp-for="DefaultLateFeePercent" type="number" min="0" max="100" />
                    <span class="hint">Tính trên số tiền còn nợ</span>
                    <span class="err" asp-validation-for="DefaultLateFeePercent"></span>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Id == 0)
    {
        <div class="card">
            <div class="card-header"><h2>Tạo sẵn căn hộ</h2></div>
            <div class="card-body">
                <p class="text-muted" style="font-size:13px;margin-top:0;">
                    Sinh sẵn căn cho mọi tầng với mã dạng <b>{Mã toà}-{Tầng}.{Số căn}</b> (vd A-12.05), trạng thái "Chưa bàn giao".
                    Để 0 nếu muốn tự thêm từng căn.
                </p>
                <div class="form-grid">
                    <div class="form-field span-6">
                        <label asp-for="UnitsPerFloor">Số căn mỗi tầng</label>
                        <input asp-for="UnitsPerFloor" type="number" min="0" max="60" />
                        <span class="err" asp-validation-for="UnitsPerFloor"></span>
                    </div>
                    <div class="form-field span-6">
                        <label asp-for="DefaultUnitArea">Diện tích mặc định (m²)</label>
                        <input asp-for="DefaultUnitArea" type="number" min="0" step="0.1" />
                        <span class="err" asp-validation-for="DefaultUnitArea"></span>
                        <span class="hint">Sửa từng căn sau khi tạo</span>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="UnitsPerFloor" value="0" />
    }

    <div class="hstack mt-3" style="justify-content:space-between;">
        <span>
            @if (Model.Id > 0)
            {
                <button type="submit" form="delete-building" class="btn btn-ghost"><span class="material-symbols-outlined">delete</span>Xoá toà</button>
            }
        </span>
        <span class="hstack">
        <button type="submit" class="btn btn-primary">Lưu</button>
        </span>
    </div>
</form>

@if (Model.Id > 0)
{
    <form id="delete-building" asp-action="Delete" asp-route-id="@Model.Id" method="post"
          data-confirm="Chỉ xoá được toà không còn căn hộ. Tiếp tục?" data-confirm-title="Xoá toà" data-confirm-ok="Xoá" data-confirm-tone="danger">
        @Html.AntiForgeryToken()
    </form>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
