@model t.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Bảng điều khiển";
    string Money(decimal v) => v.ToString("N0");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    decimal maxMonth = Model.RevenueByMonth.Count == 0 ? 0 : Model.RevenueByMonth.Max(r => r.Total);
    decimal sumBreakdown = Model.BreakdownManagement + Model.BreakdownUtilities + Model.BreakdownServices;
    string MoMColor = Model.MoMGrowthPct > 0 ? "var(--admin-success)" :
                      Model.MoMGrowthPct < 0 ? "var(--admin-danger)" : "var(--admin-muted)";
    string MoMArrow = Model.MoMGrowthPct > 0 ? "trending_up" :
                      Model.MoMGrowthPct < 0 ? "trending_down" : "trending_flat";
    string PriPill(MaintenancePriority p) => p switch
    {
        MaintenancePriority.Urgent => "pill pill-danger",
        MaintenancePriority.High => "pill pill-warning",
        MaintenancePriority.Medium => "pill pill-info",
        _ => "pill pill-neutral"
    };
    string Pct(decimal part) => sumBreakdown == 0 ? "0" : (part * 100 / sumBreakdown).ToString("0.0");
}

<section class="page-header">
    <div>
        <h1>Bảng điều khiển</h1>
        <p class="subtitle">Tình hình vận hành các khu · cập nhật @DateTime.Now.ToString("HH:mm dd/MM/yyyy")</p>
    </div>
    <div class="actions">
        <a class="btn btn-outline" asp-controller="Projects" asp-action="Index"><span class="material-symbols-outlined">location_city</span>Sơ đồ khu &amp; toà</a>
        <a class="btn btn-accent" asp-controller="Utilities" asp-action="Bulk"><span class="material-symbols-outlined">water_drop</span>Ghi chỉ số tháng</a>
    </div>
</section>

<section class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-icon"><span class="material-symbols-outlined">domain</span></div>
        <div class="kpi-label">Toà nhà</div>
        <div class="kpi-value">@Model.BuildingsTotal</div>
        <div class="kpi-meta">@Model.UnitsTotal căn hộ</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><span class="material-symbols-outlined">door_front</span></div>
        <div class="kpi-label">Có người ở</div>
        <div class="kpi-value">@Model.OccupancyRate%</div>
        <div class="kpi-meta">@Model.UnitsOccupied đang ở · @Model.UnitsAvailable để trống</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><span class="material-symbols-outlined">groups</span></div>
        <div class="kpi-label">Cư dân</div>
        <div class="kpi-value">@Model.ResidentsTotal</div>
        <div class="kpi-meta">@Model.UsersTotal tài khoản trên hệ thống</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon"><span class="material-symbols-outlined">payments</span></div>
        <div class="kpi-label">Đã thu tháng này</div>
        <div class="kpi-value">@Money(Model.RevenueThisMonth)</div>
        <div class="kpi-meta" style="color:@MoMColor;">
            <span class="material-symbols-outlined" style="font-size:14px;vertical-align:-2px;">@MoMArrow</span>
            @(Model.MoMGrowthPct > 0 ? "+" : "")@Model.MoMGrowthPct% so với tháng trước
        </div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="color:var(--admin-danger);"><span class="material-symbols-outlined">money_off</span></div>
        <div class="kpi-label">Công nợ phải thu</div>
        <div class="kpi-value">@Money(Model.ArrearsTotal)</div>
        <div class="kpi-meta"><a asp-controller="Payments" asp-action="Index" style="text-decoration:underline;">@Model.InvoicesUnpaid hoá đơn chưa thu</a></div>
    </div>
    <div class="kpi-card">
        <div class="kpi-icon" style="color:var(--admin-warning);"><span class="material-symbols-outlined">build</span></div>
        <div class="kpi-label">Sự cố đang mở</div>
        <div class="kpi-value">@Model.MaintenanceOpen</div>
        <div class="kpi-meta"><a asp-controller="Maintenance" asp-action="Index" style="text-decoration:underline;">Xem hàng đợi xử lý</a></div>
    </div>
</section>

<section class="stat-strip">
    <div class="stat"><div class="stat-label">Phí cố định dự kiến/tháng</div><div class="stat-value">@Money(Model.RevenueForecastNext)</div><div class="stat-sub">phí quản lý + gửi xe, chưa gồm nước</div></div>
    <div class="stat"><div class="stat-label">Tỉ lệ thu</div><div class="stat-value">@Model.CollectionRate%</div><div class="stat-sub">đã thu / tổng đã phát hành</div></div>
    <div class="stat"><div class="stat-label">Thu 30 ngày qua</div><div class="stat-value">@Money(Model.RevenueLast30Days)</div></div>
    <div class="stat"><div class="stat-label">Trung bình/tháng</div><div class="stat-value">@Money(Model.RevenueAvgPerMonth)</div><div class="stat-sub">12 tháng gần nhất</div></div>
    <div class="stat"><div class="stat-label">Tổng đã thu</div><div class="stat-value">@Money(Model.RevenueAllTime)</div></div>
</section>

<section style="display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:1.2rem;">
    <div class="card">
        <div class="card-header">
            <h2>Tiền thu theo tháng</h2>
            <span class="text-muted">12 tháng gần nhất · VNĐ</span>
        </div>
        <div class="card-body">
            @if (maxMonth == 0)
            {
                <div class="empty-state" style="padding:1.5rem;"><span class="material-symbols-outlined">show_chart</span><h3>Chưa có khoản thu</h3></div>
            }
            else
            {
                <div style="position:relative;height:260px;"><canvas id="revenueMonthChart"></canvas></div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2>Cơ cấu khoản thu</h2></div>
        <div class="card-body">
            @if (sumBreakdown == 0)
            {
                <div class="empty-state" style="padding:1.5rem;"><span class="material-symbols-outlined">donut_large</span><h3>Chưa có dữ liệu</h3></div>
            }
            else
            {
                <div style="position:relative;height:180px;"><canvas id="breakdownChart"></canvas></div>
                <div class="mini-list" style="margin-top:.8rem;">
                    <div class="row"><span><span class="dot" style="display:inline-block;width:10px;height:10px;border-radius:3px;background:#0f2a44;margin-right:6px;"></span>Phí quản lý</span><b>@Money(Model.BreakdownManagement) · @Pct(Model.BreakdownManagement)%</b></div>
                    <div class="row"><span><span class="dot" style="display:inline-block;width:10px;height:10px;border-radius:3px;background:#0ea5e9;margin-right:6px;"></span>Điện / nước</span><b>@Money(Model.BreakdownUtilities) · @Pct(Model.BreakdownUtilities)%</b></div>
                    <div class="row"><span><span class="dot" style="display:inline-block;width:10px;height:10px;border-radius:3px;background:#c8963e;margin-right:6px;"></span>Gửi xe &amp; khác</span><b>@Money(Model.BreakdownServices) · @Pct(Model.BreakdownServices)%</b></div>
                </div>
            }
        </div>
    </div>
</section>

<section style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:1.2rem;">
    <div class="card">
        <div class="card-header">
            <h2>Sự cố cần xử lý</h2>
            <a class="btn btn-ghost btn-sm" asp-controller="Maintenance" asp-action="Index">Tất cả →</a>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Yêu cầu</th><th>Căn</th><th>Ưu tiên</th><th>Trạng thái</th><th>Báo lúc</th></tr></thead>
                <tbody>
                @if (!Model.RecentMaintenance.Any())
                {
                    <tr><td colspan="5"><div class="empty-state"><span class="material-symbols-outlined">task_alt</span><h3>Không có sự cố tồn đọng</h3></div></td></tr>
                }
                @foreach (var m in Model.RecentMaintenance)
                {
                    <tr data-href="@Url.Action("Details", "Maintenance", new { id = m.Id })">
                        <td><span class="row-title">@m.Title</span><div class="row-meta">@m.RequestNumber</div></td>
                        <td class="no-wrap">@m.UnitCode</td>
                        <td><span class="@PriPill(m.Priority)">@m.Priority.Vi()</span></td>
                        <td>@m.Status.Vi()</td>
                        <td class="text-muted no-wrap">@m.ReportedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <div class="card-header"><h2>Công nợ theo toà</h2></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Toà</th><th class="num">Đang ở</th><th class="num">Còn phải thu</th></tr></thead>
                <tbody>
                @foreach (var b in Model.TopBuildings)
                {
                    var rate = b.Units == 0 ? 0 : Math.Round(b.Occupied * 100.0 / b.Units, 0);
                    <tr data-href="@Url.Action("Details", "Buildings", new { id = b.Id })">
                        <td><span class="row-title">@b.Name</span></td>
                        <td class="num">@b.Occupied/@b.Units <span class="text-muted">(@rate%)</span></td>
                        <td class="num" style="@(b.MonthlyRevenue > 0 ? "color:var(--st-debt);font-weight:600;" : "")">@Money(b.MonthlyRevenue)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</section>

<section class="card">
    <div class="card-header">
        <h2>Căn đóng phí nhiều nhất</h2>
        <span class="text-muted">Cộng dồn từ trước đến nay</span>
    </div>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>#</th><th>Căn</th><th>Toà</th><th class="num">Hoá đơn đã thu</th><th class="num">Tổng đã thu</th></tr></thead>
            <tbody>
            @if (!Model.TopApartments.Any())
            {
                <tr><td colspan="5"><div class="empty-state"><span class="material-symbols-outlined">door_front</span><h3>Chưa có dữ liệu thu</h3></div></td></tr>
            }
            @{ var rank = 0; }
            @foreach (var a in Model.TopApartments)
            {
                rank++;
                <tr data-href="@Url.Action("Details", "Apartments", new { id = a.Id })">
                    <td><span class="pill @(rank == 1 ? "pill-accent" : "pill-neutral")">#@rank</span></td>
                    <td><span class="row-title">@a.UnitCode</span></td>
                    <td>@(a.BuildingName ?? "—")</td>
                    <td class="num">@a.InvoiceCount</td>
                    <td class="num"><strong>@Money(a.TotalCollected)</strong></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    @if (maxMonth > 0 || sumBreakdown > 0)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
        <script>
            (function () {
                if (!window.Chart) return;
                var fmtVN = function (v) { return v >= 1000000 ? (v / 1000000).toFixed(1) + 'tr' : v >= 1000 ? (v / 1000).toFixed(0) + 'k' : v; };
                var fmtFull = function (v) { return new Intl.NumberFormat('vi-VN').format(v) + ' đ'; };

                var monthCanvas = document.getElementById('revenueMonthChart');
                if (monthCanvas) {
                    var labels = [@Html.Raw(string.Join(",", Model.RevenueByMonth.Select(m => $"\"{m.Label}\"")))];
                    var data = [@Html.Raw(string.Join(",", Model.RevenueByMonth.Select(m => m.Total.ToString(inv))))];
                    var avg = @Model.RevenueAvgPerMonth.ToString(inv);
                    new Chart(monthCanvas.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: labels,
                            datasets: [
                                { label: 'Đã thu', data: data, backgroundColor: data.map(function (v) { return v >= avg ? '#0f2a44' : '#94a3b8'; }), borderRadius: 6, maxBarThickness: 36, order: 2 },
                                { label: 'Trung bình', data: data.map(function () { return avg; }), type: 'line', borderColor: '#c8963e', borderDash: [6, 4], borderWidth: 2, pointRadius: 0, fill: false, order: 1 }
                            ]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false,
                            plugins: { legend: { position: 'bottom' }, tooltip: { callbacks: { label: function (c) { return c.dataset.label + ': ' + fmtFull(c.parsed.y); } } } },
                            scales: { x: { grid: { display: false } }, y: { ticks: { callback: fmtVN }, grid: { color: 'rgba(15,23,42,0.06)' } } }
                        }
                    });
                }

                var brkCanvas = document.getElementById('breakdownChart');
                if (brkCanvas) {
                    new Chart(brkCanvas.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: ['Phí quản lý', 'Điện / nước', 'Gửi xe & khác'],
                            datasets: [{
                                data: [@Model.BreakdownManagement.ToString(inv), @Model.BreakdownUtilities.ToString(inv), @Model.BreakdownServices.ToString(inv)],
                                backgroundColor: ['#0f2a44', '#0ea5e9', '#c8963e'], borderWidth: 0
                            }]
                        },
                        options: {
                            responsive: true, maintainAspectRatio: false, cutout: '62%',
                            plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return c.label + ': ' + fmtFull(c.parsed); } } } }
                        }
                    });
                }
            })();
        </script>
    }
}
