@model t.Areas.Admin.Models.ProjectEditVm
@using t.Models.Entities
@{
    ViewData["Title"] = Model.Id == 0 ? "Thêm khu" : Model.Name;
}

<section class="page-header">
    <div>
        <h1>@(Model.Id == 0 ? "Thêm khu" : Model.Name)</h1>
        <p class="subtitle">@(Model.Id == 0 ? "Khu gồm nhiều toà, quản lý chung một Ban quản lý." : "Cập nhật thông tin khu.")</p>
    </div>
    <div class="actions">
        <a class="btn btn-ghost" href="@(Model.Id == 0 ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Quay lại</a>
    </div>
</section>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex");"></div>

    <div class="card">
        <div class="card-header"><h2>Thông tin khu</h2></div>
        <div class="card-body">
            <div class="form-grid">
                <div class="form-field span-8">
                    <label asp-for="Name">Tên khu</label>
                    <input asp-for="Name" placeholder="VD: Luxe Haven Grand Park" />
                    <span class="err" asp-validation-for="Name"></span>
                </div>


                <div class="form-field span-12">
                    <label asp-for="Address">Địa chỉ</label>
                    <input asp-for="Address" />
                    <span class="err" asp-validation-for="Address"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="hstack mt-3" style="justify-content:flex-end;">
        <a class="btn btn-ghost" href="@(Model.Id == 0 ? Url.Action("Index") : Url.Action("Details", new { id = Model.Id }))">Huỷ</a>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
