@model List<t.Areas.Admin.Models.ProjectListVm>
@{
    ViewData["Title"] = "Khu & toà nhà";
    var q = (string?)ViewBag.Q;
    var unassigned = (int)ViewBag.UnassignedBuildings;
    string Money(decimal v) => v.ToString("N0");
    var totalUnits = Model.Sum(p => p.ApartmentCount);
    var totalOccupied = Model.Sum(p => p.OccupiedCount);
}

<section class="page-header">
    <div>
        <span class="eyebrow"><span class="material-symbols-outlined" style="font-size:16px;">location_city</span>Cấp 1 · Khu</span>
        <h1>Khu &amp; toà nhà</h1>
        <p class="subtitle">@Model.Count khu · @Model.Sum(p => p.BuildingCount) toà · @totalUnits căn hộ · @Model.Sum(p => p.ResidentCount) cư dân đang ở</p>
    </div>
    <div class="actions">
        <form method="get" class="hstack">
            <input class="plan-search" type="search" name="q" value="@q" placeholder="Tìm khu theo tên, địa chỉ…" />
        </form>
        <a class="btn btn-primary" asp-action="Create"><span class="material-symbols-outlined">add</span>Thêm khu</a>
    </div>
</section>

@if (unassigned > 0)
{
    <div class="alert alert-warning">
        <span class="material-symbols-outlined">info</span>
        <span>Có @unassigned toà chưa thuộc khu nào. <a asp-action="Unassigned" style="text-decoration:underline;">Xem và gán khu</a>.</span>
    </div>
}

<div class="entity-grid">
    @foreach (var p in Model)
    {
        var occPct = p.ApartmentCount == 0 ? 0 : p.OccupiedCount * 100.0 / p.ApartmentCount;
        <a class="entity-card" asp-action="Details" asp-route-id="@p.Id">
            <div class="cover" style="background-image:url('@(string.IsNullOrEmpty(p.ThumbnailUrl) ? "/img/hero-2.jpg" : p.ThumbnailUrl)')">
                <div class="cover-title">
                    <h3>@p.Name</h3>
                    <small><span class="material-symbols-outlined" style="font-size:14px;vertical-align:-2px;">location_on</span> @p.Address</small>
                </div>
            </div>
            <div class="body">
                <div class="metrics">
                    <div class="metric"><b>@p.BuildingCount</b><span>toà</span></div>
                    <div class="metric"><b>@p.ApartmentCount</b><span>căn hộ</span></div>
                    <div class="metric"><b>@p.ResidentCount</b><span>cư dân</span></div>
                </div>
                <div>
                    <div class="hstack" style="justify-content:space-between;font-size:13px;margin-bottom:.35rem;">
                        <span>Tỉ lệ có người ở</span><b>@p.OccupancyRate%</b>
                    </div>
                    <div class="occ-bar"><span class="occ" style="width:@occPct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></span></div>
                </div>
                <div class="foot">
                    <span>@p.RegionName</span>
                    @if (p.Outstanding > 0)
                    {
                        <span style="color:var(--st-debt);font-weight:600;">Còn thu @Money(p.Outstanding) đ</span>
                    }
                    else
                    {
                        <span>Không có công nợ</span>
                    }
                </div>
            </div>
        </a>
    }
    <a class="entity-card add-card" asp-action="Create">
        <span class="material-symbols-outlined">add_business</span>
        Thêm khu mới
    </a>
</div>

@if (Model.Any())
{
    <div class="text-muted" style="font-size:13px;">
        Toàn hệ thống: @totalOccupied/@totalUnits căn đang có người ở.
    </div>
}
