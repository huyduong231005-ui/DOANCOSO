@model t.Infrastructure.Maintenance.MaintenanceKpiSummary
@{
    ViewData["Title"] = "Báo cáo sự cố";
    var from = (DateTime)ViewBag.From;
    var to = (DateTime)ViewBag.To;
    var buildingId = (int?)ViewBag.BuildingId;
    var buildings = (List<Building>)ViewBag.Buildings;
    string Pct(double? v) => v == null ? "—" : (v.Value * 100).ToString("0.#") + "%";
    string Hours(double? v) => v == null ? "—" : v.Value < 1 ? (v.Value * 60).ToString("0") + " phút" : v.Value.ToString("0.#") + " giờ";
    string Num(double? v, string fmt = "0.#") => v == null ? "—" : v.Value.ToString(fmt);
}

<section class="page-header">
    <div>
        <h1>Báo cáo sự cố</h1>
        <p class="subtitle">Yêu cầu báo từ @from.ToString("dd/MM/yyyy") đến @to.ToString("dd/MM/yyyy") · @Model.Total yêu cầu</p>
    </div>
</section>

<partial name="_ReportTabs" />

<form method="get" class="filter-bar">
    <label class="hstack" style="font-size:14px;">Từ <input type="date" name="from" value="@from.ToString("yyyy-MM-dd")" /></label>
    <label class="hstack" style="font-size:14px;">Đến <input type="date" name="to" value="@to.ToString("yyyy-MM-dd")" /></label>
    <select name="buildingId">
        <option value="">— Tất cả toà —</option>
        @foreach (var b in buildings) { <option value="@b.Id" selected="@(buildingId == b.Id)">@b.Name</option> }
    </select>
    <button type="submit" class="btn btn-primary">Xem</button>
</form>

<section class="kpi-grid">
    <div class="kpi-card">
        <div class="kpi-label">Hoàn tất đúng hạn</div>
        <div class="kpi-value">@Pct(Model.OnTimeRate)</div>
        <div class="kpi-meta">@Model.Resolved đã hoàn tất · MTTR @Hours(Model.MttrHours)</div>
    </div>
    <div class="kpi-card">
        <div class="kpi-label">Phản hồi trong SLA</div>
        <div class="kpi-value">@Pct(Model.ResponseOnTimeRate)</div>
        <div class="kpi-meta">Trung bình @Hours(Model.ResponseAvgMinutes / 60) từ lúc báo đến tiếp nhận</div>
    </div>
    <a class="kpi-card" asp-controller="Maintenance" asp-action="Index" asp-route-overdue="true">
        <div class="kpi-label">Đang mở / quá hạn</div>
        <div class="kpi-value" style="@(Model.OverdueNow > 0 ? "color:var(--admin-danger);" : "")">@Model.Open / @Model.OverdueNow</div>
        <div class="kpi-meta">Trong số yêu cầu của kỳ này</div>
    </a>
    <div class="kpi-card">
        <div class="kpi-label">Tự giao được giữ nguyên</div>
        <div class="kpi-value">@Pct(Model.AutoKeptRate)</div>
        <div class="kpi-meta">@Model.AutoAssignedCount việc do hệ thống tự giao · hài lòng @Num(Model.CsatAvg)/5 (@Model.CsatCount đánh giá)</div>
    </div>
</section>

<p class="hint" style="margin:0;">
    Đúng hạn = hoàn tất trước hạn SLA (đã cộng thời gian tạm dừng). Tự giao được giữ nguyên = việc hệ thống tự giao theo loại sự cố (loại do cư dân chọn hoặc AI gợi ý) mà quản lý không phải giao lại.
    Tỉ lệ hiện "—" khi kỳ này chưa có mẫu.
</p>

@{
    // Một bảng nhóm dùng chung cho các cách phân tích.
    void GroupTable(string fold, string title, string keyHeader, IReadOnlyList<t.Infrastructure.Maintenance.MaintenanceKpiGroup> groups, bool showCsat)
    {
        <details class="card fold" data-fold="@fold" open>
            <summary class="card-header"><h2>@title</h2><span class="text-muted">@groups.Count nhóm</span></summary>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>@keyHeader</th><th class="num">Yêu cầu</th><th class="num">Đang mở</th><th class="num">Quá hạn</th><th class="num">Hoàn tất</th><th class="num">Đúng hạn</th><th class="num">MTTR</th>@if (showCsat) { <th class="num">Hài lòng</th> }</tr></thead>
                    <tbody>
                    @if (!groups.Any())
                    {
                        <tr><td colspan="8" class="text-muted" style="text-align:center;padding:1rem;">Chưa có dữ liệu trong kỳ.</td></tr>
                    }
                    @foreach (var g in groups)
                    {
                        <tr>
                            <td class="row-title">@(g.Name ?? "—")</td>
                            <td class="num">@g.Count</td>
                            <td class="num">@g.Open</td>
                            <td class="num" style="@(g.Overdue > 0 ? "color:var(--admin-danger);font-weight:600;" : "")">@g.Overdue</td>
                            <td class="num">@g.Resolved</td>
                            <td class="num">@Pct(g.OnTimeRate)</td>
                            <td class="num">@Hours(g.MttrHours)</td>
                            @if (showCsat) { <td class="num">@Num(g.CsatAvg)</td> }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }
}

<section style="display:grid;grid-template-columns:repeat(auto-fit,minmax(420px,1fr));gap:1.2rem;align-items:start;">
    @{ GroupTable("kpi-priority", "Theo mức ưu tiên", "Mức ưu tiên", Model.ByPriority, false); }
    @{ GroupTable("kpi-category", "Theo loại sự cố", "Loại", Model.ByCategory, false); }
</section>
@{ GroupTable("kpi-building", "Theo toà", "Toà", Model.ByBuilding, true); }
@{ GroupTable("kpi-tech", "Theo người phụ trách", "Người phụ trách", Model.ByTechnician, true); }
