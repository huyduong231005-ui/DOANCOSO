@model List<t.Areas.Admin.Models.OccupancyRow>
@{
    ViewData["Title"] = "Tình trạng căn hộ";
    string Money(decimal v) => v.ToString("N0");
    var totalUnits = Model.Sum(x => x.Total);
    var totalOcc = Model.Sum(x => x.Occupied);
    var rate = totalUnits == 0 ? 0 : Math.Round(totalOcc * 100.0 / totalUnits, 1);
    string Pct(double v) => v.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

<section class="page-header">
    <div><h1>Tình trạng căn hộ theo toà</h1><p class="subtitle">Tỉ lệ có người ở, cho thuê lại, căn trống và công nợ</p></div>
</section>

<partial name="_ReportTabs" />

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Toà</th><th class="num">Tổng</th><th class="num">Đang ở</th><th class="num">Cho thuê</th><th class="num">Trống</th><th class="num">Chưa bàn giao</th><th class="num">Sửa chữa</th><th style="min-width:200px;">Phân bổ</th><th class="num">Còn phải thu</th></tr></thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9"><div class="empty-state"><span class="material-symbols-outlined">domain</span><h3>Chưa có toà</h3></div></td></tr>
            }
            @foreach (var r in Model)
            {
                double P(int n) => r.Total == 0 ? 0 : n * 100.0 / r.Total;
                <tr data-href="@Url.Action("Details", "Buildings", new { id = r.BuildingId })">
                    <td class="row-title">@r.BuildingName</td>
                    <td class="num">@r.Total</td>
                    <td class="num">@r.Occupied <span class="text-muted">(@r.Rate%)</span></td>
                    <td class="num">@r.Rented</td>
                    <td class="num">@r.Vacant</td>
                    <td class="num">@r.NotHandedOver</td>
                    <td class="num">@r.UnderMaintenance</td>
                    <td>
                        <div class="occ-bar" title="Đang ở · Trống · Chưa bàn giao · Sửa chữa">
                            <span style="width:@Pct(P(r.Occupied))%;background:var(--st-occupied)"></span>
                            <span style="width:@Pct(P(r.Vacant))%;background:#cbd5e1"></span>
                            <span style="width:@Pct(P(r.NotHandedOver))%;background:#e2e8f0"></span>
                            <span style="width:@Pct(P(r.UnderMaintenance))%;background:#f59e0b"></span>
                        </div>
                    </td>
                    <td class="num" style="@(r.Outstanding > 0 ? "color:var(--st-debt);font-weight:600;" : "")">@Money(r.Outstanding)</td>
                </tr>
            }
            </tbody>
            @if (Model.Any())
            {
                <tfoot>
                    <tr style="font-weight:700;">
                        <td>Tổng</td>
                        <td class="num">@totalUnits</td>
                        <td class="num">@totalOcc <span class="text-muted">(@rate%)</span></td>
                        <td class="num">@Model.Sum(x => x.Rented)</td>
                        <td class="num">@Model.Sum(x => x.Vacant)</td>
                        <td class="num">@Model.Sum(x => x.NotHandedOver)</td>
                        <td class="num">@Model.Sum(x => x.UnderMaintenance)</td>
                        <td></td>
                        <td class="num" style="color:var(--st-debt);">@Money(Model.Sum(x => x.Outstanding))</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
