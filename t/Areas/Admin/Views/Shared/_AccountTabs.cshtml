@* Gộp Tài khoản và Vai trò & quyền thành một mục. *@
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
}
<nav class="subnav">
    <a class="@(ctrl == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">Tài khoản</a>
    <a class="@(ctrl == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index">Vai trò &amp; quyền</a>
</nav>
