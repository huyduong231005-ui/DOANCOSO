@model t.Models.Entities.MaintenanceRequest
@using t.Models.Entities
@{
    ViewData["Title"] = Model.RequestNumber;
    var next = (IReadOnlyList<MaintenanceStatus>)ViewBag.NextStatuses;
    string Local(DateTime d) => d.ToLocalTime().ToString("HH:mm dd/MM/yyyy");
    var building = Model.Apartment?.Floor.Building ?? Model.CommonBuilding;
    string Pill(MaintenanceStatus s) => s switch
    {
        MaintenanceStatus.Open => "pill pill-warning",
        MaintenanceStatus.Acknowledged => "pill pill-info",
        MaintenanceStatus.InProgress => "pill pill-accent",
        MaintenanceStatus.Resolved => "pill pill-success",
        MaintenanceStatus.Rejected => "pill pill-danger",
        _ => "pill pill-neutral"
    };
    string PrioPill(MaintenancePriority p) => p switch
    {
        MaintenancePriority.Urgent => "pill pill-danger",
        MaintenancePriority.High => "pill pill-warning",
        MaintenancePriority.Medium => "pill pill-info",
        _ => "pill pill-neutral"
    };
    // Cư dân không thấy tên người thao tác nội bộ, chỉ thấy bước tiến độ.
    string StepText(MaintenanceStatusChange h, MaintenanceStatus? from) => from == null ? "Đã gửi yêu cầu"
        : from == h.ToStatus ? "Đã phân công kỹ thuật viên"
        : h.ToStatus switch
        {
            MaintenanceStatus.Acknowledged => "Ban quản lý đã tiếp nhận",
            MaintenanceStatus.InProgress => from == MaintenanceStatus.Resolved ? "Mở lại: chưa khắc phục" : "Kỹ thuật viên đang xử lý",
            MaintenanceStatus.OnHold => "Tạm dừng",
            MaintenanceStatus.Resolved => "Đã sửa xong, chờ bạn xác nhận",
            MaintenanceStatus.Closed => "Đã đóng",
            MaintenanceStatus.Rejected => "Ban quản lý từ chối",
            MaintenanceStatus.Cancelled => "Đã huỷ",
            _ => h.ToStatus.Vi()
        };
}

<section class="page-header">
    <div><h1>@Model.RequestNumber</h1><p class="subtitle">@Model.Title · @Model.PlaceLabel</p></div>
    <div class="actions">
        <span class="@PrioPill(Model.Priority)">@Model.Priority.Vi()</span>
        <span class="@Pill(Model.Status)">@Model.Status.Vi()</span>
        <a class="btn btn-ghost" asp-action="Index">Quay lại</a>
    </div>
</section>

@if (next.Contains(MaintenanceStatus.Closed))
{
    <div class="card">
        <div class="card-header"><h2>Sự cố đã được xử lý xong chưa?</h2></div>
        <div class="card-body vstack">
            <form asp-action="ChangeStatus" method="post" class="hstack" style="flex-wrap:wrap;gap:.5rem;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@((int)MaintenanceStatus.Closed)" />
                <label>Đánh giá
                    <select name="rating">
                        @for (var i = 5; i >= 1; i--) { <option value="@i">@i sao</option> }
                    </select>
                </label>
                <input name="note" maxlength="500" placeholder="Nhận xét (không bắt buộc)" style="flex:1;min-width:200px;" />
                <button type="submit" class="btn btn-accent"><span class="material-symbols-outlined">check</span>Xác nhận đã xong</button>
            </form>
            <form asp-action="ChangeStatus" method="post" class="hstack" style="flex-wrap:wrap;gap:.5rem;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@((int)MaintenanceStatus.InProgress)" />
                <input name="note" required maxlength="500" placeholder="Còn lỗi gì?" style="flex:1;min-width:200px;" />
                <button type="submit" class="btn btn-ghost"><span class="material-symbols-outlined">replay</span>Chưa khắc phục</button>
            </form>
        </div>
    </div>
}

<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:1.2rem;">
    <div class="vstack">
        <div class="card">
            <div class="card-header"><h2>Mô tả</h2></div>
            <div class="card-body">
                <p style="white-space:pre-wrap;">@Model.Description</p>
                @foreach (var group in Model.Photos.GroupBy(p => p.Stage).OrderBy(g => g.Key))
                {
                    <div class="text-muted" style="font-size:13px;">@(group.Key == MaintenancePhotoStage.Report ? "Ảnh hiện trạng" : "Ảnh sau khi sửa")</div>
                    <div class="hstack mt-2" style="flex-wrap:wrap;">
                        @foreach (var p in group) { <img src="@p.Url" alt="" style="width:120px;height:90px;object-fit:cover;border-radius:8px;border:1px solid var(--admin-line);" /> }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ResolutionNote))
        {
            <div class="card">
                <div class="card-header"><h2>Phản hồi từ ban quản lý</h2></div>
                <div class="card-body"><p style="white-space:pre-wrap;">@Model.ResolutionNote</p></div>
            </div>
        }

        <div class="card">
            <div class="card-header"><h2>Tiến độ</h2></div>
            <div class="card-body vstack">
                @foreach (var (h, from) in MaintenanceStatusChange.WithFrom(Model.History))
                {
                    <div class="hstack">
                        <span class="material-symbols-outlined" style="color:var(--admin-muted);">radio_button_checked</span>
                        <div>
                            <strong>@StepText(h, from)</strong>
                            <div class="text-muted">@Local(h.ChangedAt)@(h.Note != null && from != null && from != h.ToStatus ? " · " + h.Note : "")</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (next.Contains(MaintenanceStatus.Cancelled))
        {
            <form asp-action="ChangeStatus" method="post" onsubmit="return confirm('Huỷ yêu cầu @Model.RequestNumber?')">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@((int)MaintenanceStatus.Cancelled)" />
                <input type="hidden" name="note" value="Cư dân tự huỷ" />
                <button type="submit" class="btn btn-ghost btn-sm"><span class="material-symbols-outlined">block</span>Huỷ yêu cầu (chỉ khi kỹ thuật chưa bắt đầu)</button>
            </form>
        }
    </div>

    <div class="card">
        <div class="card-header"><h2>Thông tin</h2></div>
        <div class="card-body">
            <dl class="dl-pairs">
                <dt>Loại</dt><dd>@Model.Category.Vi()</dd>
                <dt>Mức độ</dt><dd>@Model.Priority.Vi()</dd>
                <dt>Nơi xảy ra</dt><dd>@Model.PlaceLabel</dd>
                @if (building != null) { <dt>Toà</dt><dd>@building.Name</dd> }
                <dt>Phụ trách</dt><dd>@(Model.AssignedTo?.FullName ?? "Chưa phân công")</dd>
                @if (Model.DueAt.HasValue && MaintenanceRequest.ActiveStatuses.Contains(Model.Status)) { <dt>Dự kiến xong trước</dt><dd>@Local(Model.DueAt.Value)</dd> }
                @if (Model.Rating != null) { <dt>Bạn đánh giá</dt><dd>@Model.Rating/5</dd> }
            </dl>
        </div>
    </div>
</div>
