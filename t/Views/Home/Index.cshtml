@model List<t.Models.ViewModels.LandingProjectVm>
@{
    ViewData["Title"] = "Trang chủ";
    ViewData["BodyClass"] = "luxe-landing";
    ViewData["ActiveNav"] = "home";
}

<partial name="_LuxeTopbar" />

<main class="lh-main">
    <section class="hero">
        <div class="hero-slideshow" aria-hidden="true">
            <img class="hero-slide is-active" src="~/img/hero-1.jpg" alt="">
            <img class="hero-slide" src="~/img/hero-2.jpg" alt="">
            <img class="hero-slide" src="~/img/hero-3.jpg" alt="">
            <img class="hero-slide" src="~/img/hero-4.jpg" alt="">
        </div>
        <div class="hero-overlay"></div>

        <div class="shell hero-content intro-strong">
            <span class="hero-eyebrow">Ban quản lý vận hành khu căn hộ</span>
            <h1>
                SỐNG AN TÂM<br>
                <span class="script">trong từng</span>
                TOÀ NHÀ
            </h1>
            <div class="landing-cta">
                <a class="button-primary" asp-controller="Home" asp-action="Login">
                    <span class="material-symbols-outlined">login</span> Đăng nhập cổng cư dân
                </a>
                <a class="landing-ghost" href="#khu">Các khu đang vận hành</a>
            </div>
        </div>
    </section>

    <section class="section" id="khu">
        <div class="shell">
            <div class="center-head reveal-item fx-pop">
                <h2 class="section-title solid">KHU ĐANG VẬN HÀNH</h2>
                <p>Mỗi khu gồm nhiều toà, quản lý thống nhất từ một Ban quản lý</p>
            </div>

            @if (!Model.Any())
            {
                <p class="landing-empty">Chưa có khu nào được thiết lập.</p>
            }
            else
            {
                <div class="landing-projects">
                    @foreach (var p in Model)
                    {
                        <article class="landing-project reveal-item fx-up">
                            <img src="@(string.IsNullOrEmpty(p.ThumbnailUrl) ? "/img/hero-2.jpg" : p.ThumbnailUrl)" alt="@p.Name" loading="lazy" />
                            <div class="landing-project-body">
                                <h3>@p.Name</h3>
                                <p class="landing-project-addr"><span class="material-symbols-outlined">location_on</span>@p.Address</p>
                                @if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                                {
                                    <p>@p.ShortDescription</p>
                                }
                                <div class="landing-project-stats">
                                    <span><strong>@p.BuildingCount</strong> toà</span>
                                    <span><strong>@p.ApartmentCount</strong> căn hộ</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="section services-section">
        <div class="shell services-grid">
            <article class="service-item reveal-item fx-flip" data-reveal-delay="0">
                <div class="icon"><span class="material-symbols-outlined">receipt_long</span></div>
                <h3>Phí dịch vụ minh bạch</h3>
                <p>Phí quản lý, điện, nước, gửi xe tính theo từng căn; cư dân xem hoá đơn và chuyển khoản bằng mã QR.</p>
            </article>
            <article class="service-item reveal-item fx-flip" data-reveal-delay="120">
                <div class="icon"><span class="material-symbols-outlined">build</span></div>
                <h3>Báo sự cố 24/7</h3>
                <p>Gửi yêu cầu sửa chữa ngay trên cổng cư dân, hệ thống tự phân loại và chuyển đúng tổ kỹ thuật.</p>
            </article>
            <article class="service-item reveal-item fx-flip" data-reveal-delay="240">
                <div class="icon"><span class="material-symbols-outlined">groups</span></div>
                <h3>Quản lý cư dân</h3>
                <p>Ban quản lý nắm rõ từng căn: chủ hộ, thành viên, người thuê và lịch sử chi phí.</p>
            </article>
        </div>
    </section>
</main>

<footer class="lh-footer">
    <div class="shell footer-grid reveal-item fx-up">
        <div class="footer-brand">
            <h4>Luxe Haven</h4>
            <p>Ban quản lý vận hành khu căn hộ: thu phí, kỹ thuật, an ninh và chăm sóc cư dân.</p>
        </div>

        <div class="footer-col">
            <h6>Cư dân</h6>
            <ul>
                <li><a asp-controller="Home" asp-action="Login">Đăng nhập</a></li>
                <li><a asp-controller="Home" asp-action="Register">Tạo tài khoản</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
            </ul>
        </div>

        <div class="footer-col">
            <h6>Liên hệ Ban quản lý</h6>
            <ul class="contact-list">
                <li><span class="material-symbols-outlined">mail</span> bql@luxehaven.vn</li>
                <li class="phone"><span class="material-symbols-outlined">phone</span> 1900 6789 (24/7)</li>
                <li><span class="material-symbols-outlined">location_on</span> Sảnh toà A, TP. Thủ Đức, TP. HCM</li>
            </ul>
        </div>
    </div>

    <div class="shell footer-bottom">© @DateTime.Now.Year Luxe Haven · Ban quản lý khu căn hộ.</div>
</footer>
