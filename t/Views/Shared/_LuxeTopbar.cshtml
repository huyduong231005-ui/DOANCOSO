@{
    var activeNav = (ViewData["ActiveNav"] as string ?? string.Empty).ToLowerInvariant();
    var isHome = activeNav == "home";
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var displayName = User?.Identity?.Name;
    var isAdminOrManager = User?.IsInRole("Admin") == true || User?.IsInRole("Manager") == true;
    var isTenant = User?.IsInRole("Tenant") == true;
    var avatarInitial = !string.IsNullOrWhiteSpace(displayName)
        ? displayName.Trim().Substring(0, 1).ToUpperInvariant()
        : "?";
}

<header class="topbar">
    <div class="topbar-shell topbar-inner">
        <a class="brand" asp-controller="Home" asp-action="Index" data-soft-nav="true">
            <span class="brand-mark">L</span>
            <span class="brand-name">Luxe Haven</span>
        </a>

        <nav class="menu" aria-label="Điều hướng chính">
            <a class="@(isHome ? "active" : string.Empty)" asp-controller="Home" asp-action="Index" data-soft-nav="true">Trang chủ</a>
            <a href="/#khu">Các khu</a>
        </nav>

        <div class="nav-cta">
            @if (isAuthenticated)
            {
                <div class="user-menu" data-user-menu>
                    <button type="button" class="user-menu-trigger" data-user-menu-trigger aria-haspopup="true" aria-expanded="false">
                        <span class="user-avatar">@avatarInitial</span>
                        <span class="user-menu-name">@displayName</span>
                        <span class="material-symbols-outlined user-menu-caret">expand_more</span>
                    </button>
                    <div class="user-menu-panel" data-user-menu-panel role="menu">
                        @if (isAdminOrManager)
                        {
                            <a class="user-menu-item" href="/admin" role="menuitem" title="Quay về giao diện quản trị">
                                <span class="material-symbols-outlined">dashboard</span>Quản trị
                            </a>
                        }
                        @if (isTenant)
                        {
                            <a class="user-menu-item" href="/tenant" role="menuitem" title="Cổng cư dân">
                                <span class="material-symbols-outlined">person</span>Cổng cư dân
                            </a>
                        }
                        <div class="user-menu-divider"></div>
                        <form asp-controller="Home" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="user-menu-item user-menu-logout" role="menuitem">
                                <span class="material-symbols-outlined">logout</span>Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <a class="login-link" asp-controller="Home" asp-action="Login" data-soft-nav="true">Đăng nhập</a>
            }

        </div>
    </div>
</header>
